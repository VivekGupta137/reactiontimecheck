---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@heroui/react";

import "../styles/global.css";
import ReactionTest from "@/components/reaction-test/ReactionTest";
import { getEntry } from "astro:content";
import { render } from "astro:content";
import ProductCard from "@/components/ProductCard";
import StructuredData from "@/components/StructuredData.astro";

const matches = import.meta.glob("../content/*.{md,mdx}", {
    eager: true,
});
const homepage = await getEntry("content", "home-page");
if (!homepage) {
    // Handle Error, for example:
    throw new Error("Could not find reactionTest content");
}

const { Content, headings } = await render(homepage);
---

<BaseLayout
    title="Check Reaction Time - Test Your Gaming Reflexes Online"
    description="Free online reaction time test. Measure your reaction speed, track your progress, and improve your gaming reflexes. Compare your results with pro gamers."
    image="/open-graph/home.png"
>
    <StructuredData
        slot="head"
        type="WebSite"
    />
    <ReactionTest client:load />
    <div class="flex gap-2 justify-center my-10 flex-wrap px-4">
        <ProductCard
            icon={"zap"}
            href="/reaction-time-test"
            heading="Reaction Time"
            client:idle
        >
            Measure your reaction time with this simple test. Click as soon as
            the screen turns green to see your results in milliseconds.
        </ProductCard>
        <ProductCard
            icon={"keyboard"}
            href="https://ninjatype.com"
            heading="Typing Speed"
            client:idle
        >
            Test and improve your typing speed with NinjaType. Challenge
            yourself with various texts and track your progress over time.
        </ProductCard>
        <ProductCard
            icon={"brain"}
            href="/number-memory-test"
            heading="Number Memory"
            client:idle
        >
            Test and enhance your number memory skills with our interactive
            Number Memory Test. See how many digits you can remember in
            sequence.
        </ProductCard>
    </div>
    <div
        class="prose dark:prose-invert prose-zinc w-full max-w-full px-2 md:px-6 lg:px-8"
    >
        <Content />
    </div>
</BaseLayout>
