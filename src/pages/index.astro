---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@heroui/react";

import "../styles/global.css";
import ReactionTest from "@/components/reaction-test/ReactionTest";
import { getEntry } from "astro:content";
import { render } from "astro:content";
import ProductCard from "@/components/ProductCard";
import StructuredData from "@/components/StructuredData.astro";
import ProductList from "@/components/ProductList";
import { websiteSchema, getBreadcrumbSchema } from "@/lib/schema";
import Markdown from "@/components/Markdown.astro";

const breadcrumbs = await getBreadcrumbSchema([
    { name: "Home", url: "https://checkreactiontime.com" },
]);

const matches = import.meta.glob("../content/*.{md,mdx}", {
    eager: true,
});
const homepage = await getEntry("content", "home-page");
if (!homepage) {
    // Handle Error, for example:
    throw new Error("Could not find reactionTest content");
}

const { Content, headings } = await render(homepage);
---

<BaseLayout
    title="Free Reaction Time Test - Measure Your Reflexes Online"
    description="Test your reaction time free. Measure gaming reflexes in milliseconds, track progress, compare with pros. Instant results. Start testing now!"
    image="/open-graph/home.png"
>
    <StructuredData
        slot="head"
        schema={websiteSchema}
    />
    <StructuredData
        slot="head"
        schema={breadcrumbs}
    />
    <ReactionTest client:load />
    <ProductList />
    <Markdown>
        <Content />
    </Markdown>
</BaseLayout>
