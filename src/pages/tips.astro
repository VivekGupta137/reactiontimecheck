---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BaseHead from "@/layouts/BaseHead.astro";
import { getEntry } from "astro:content";
import { render } from "astro:content";
import "@/styles/global.css";
import Markdown from "@/components/Markdown.astro";

const tipsContent = await getEntry("content", "improvement-tips");
const { Content } = await render(tipsContent!);
---

<BaseLayout>
    <BaseHead
        slot="head"
        title="Tips to Improve Reaction Time, Typing Speed & Focus | ReactionTimeCheck"
    />
    <meta
        slot="head"
        name="description"
        content="Learn proven tips to improve your reaction time, typing speed, focus, and cognitive performance. Free training advice from ReactionTimeCheck."
    />
    <Markdown>
        <Content />
    </Markdown>
</BaseLayout>
