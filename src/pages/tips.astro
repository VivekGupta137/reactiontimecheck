---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BaseHead from "@/layouts/BaseHead.astro";
import { getEntry } from "astro:content";
import { render } from "astro:content";
import "@/styles/global.css";
import Markdown from "@/components/Markdown.astro";

const tipsContent = await getEntry("content", "improvement-tips");
const { Content } = await render(tipsContent!);
---

<BaseLayout
    title="How to Improve Reaction Time for Gaming - Proven Tips & Training"
    description="Learn proven tips to improve your reaction time for gaming, FPS titles, and esports. Expert training advice to boost your reflexes and response speed."
    image="/open-graph/tips.png"
>
    <Markdown>
        <Content />
    </Markdown>
</BaseLayout>
