---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BaseHead from "@/layouts/BaseHead.astro";

import "@/styles/global.css";
import ReactionTest from "@/components/reaction-test/ReactionTest";
import { getEntry } from "astro:content";
import { render } from "astro:content";
import Markdown from "@/components/Markdown.astro";
import StructuredData from "@/components/StructuredData.astro";
import ReviewsStructuredData from "@/components/ReviewsStructuredData.astro";
import { webApplicationSchema, getBreadcrumbSchema } from "@/lib/schema";

const breadcrumbs = await getBreadcrumbSchema([
    { name: "Home", url: "https://checkreactiontime.com" },
    {
        name: "Reaction Time Test",
        url: "https://checkreactiontime.com/reaction-time-test",
    },
]);

const rttContent = await getEntry("content", "reaction-time-test");
const { Content, headings } = await render(rttContent!);
---

<BaseLayout
    title="Reaction Time Test - Free Online Reflex Speed Tester"
    description="Test reaction time instantly. Free online tool measures your reflex speed in milliseconds. Compare with averages, track progress, improve gaming performance."
    image="/open-graph/reaction-time-test.png"
>
    <StructuredData
        slot="head"
        schema={webApplicationSchema}
    />
    <StructuredData
        slot="head"
        schema={breadcrumbs}
    />
    <ReactionTest client:load />
    <Markdown headings={headings}>
        <Content />
    </Markdown>
    <ReviewsStructuredData
        slot="head"
        itemName="Reaction Time Test"
        ratingValue={4.9}
        ratingCount={234}
        reviewCount={645}
        bestRating={5}
        worstRating={1}
    />
</BaseLayout>
