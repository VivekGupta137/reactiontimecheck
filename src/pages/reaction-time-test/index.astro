---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BaseHead from "@/layouts/BaseHead.astro";

import "@/styles/global.css";
import ReactionTest from "@/components/reaction-test/ReactionTest";
import { getEntry } from "astro:content";
import { render } from "astro:content";
import Markdown from "@/components/Markdown.astro";
import StructuredData from "@/components/StructuredData.astro";
import ReviewsStructuredData from "@/components/ReviewsStructuredData.astro";
import { webApplicationSchema } from "@/lib/schema";

const rttContent = await getEntry("content", "reaction-time-test");
const { Content, headings } = await render(rttContent!);
---

<BaseLayout
    title="Reaction Time Test - Measure Your Gaming Reflexes & Response Speed"
    description="Test your reaction time instantly with our free online reaction speed test. Measure reflex speed, compare averages, and improve your response time for gaming."
    image="/open-graph/reaction-time-test.png"
>
    <StructuredData
        slot="head"
        schema={webApplicationSchema}
    />
    <ReactionTest client:load />
    <Markdown headings={headings}>
        <Content />
    </Markdown>
    <ReviewsStructuredData
        slot="head"
        itemName="Reaction Time Test"
        ratingValue={4.9}
        ratingCount={234}
        reviewCount={645}
        bestRating={5}
        worstRating={1}
    />
</BaseLayout>
