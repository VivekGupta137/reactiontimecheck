---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BaseHead from "@/layouts/BaseHead.astro";
import Markdown from "@/components/Markdown.astro";
import "@/styles/global.css";

import { render } from "astro:content";
import { getEntry } from "astro:content";

const aboutContent = await getEntry("content", "about");
const { Content, headings } = await render(aboutContent!);
---

<BaseLayout
    title="About Us - CheckReactionTime Reaction Time & Brain Training Tools"
    description="Learn about CheckReactionTime, the team behind free reaction time tests and brain training tools. Our mission is to build accurate, fast, and fun performance measurement tools."
    image="/open-graph/about.png"
>
    <Markdown headings={headings}>
        <Content />
    </Markdown>
</BaseLayout>
