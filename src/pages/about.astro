---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BaseHead from "@/layouts/BaseHead.astro";
import Markdown from "@/components/Markdown.astro";
import "@/styles/global.css";

import { render } from "astro:content";
import { getEntry } from "astro:content";

const aboutContent = await getEntry("content", "about");
const { Content, headings } = await render(aboutContent!);
---

<BaseLayout
    title="About CheckReactionTime - Free Reaction Testing Tools"
    description="Learn about CheckReactionTime and our mission to provide free, accurate reaction time testing tools for gamers, athletes, and cognitive training."
    image="/open-graph/about.png"
>
    <Markdown headings={headings}>
        <Content />
    </Markdown>
</BaseLayout>
