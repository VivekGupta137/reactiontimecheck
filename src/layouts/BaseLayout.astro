---
import Footer from "@/components/Footer";
import "@/styles/global.css";
import BaseNav from "./BaseNav.astro";
import BaseHead from "./BaseHead.astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;

// https://docs.astro.build/en/basics/astro-components/#named-slots
---

<html
    lang="en"
    class="dark"
>
    <head>
        <BaseHead
            title={title}
            description={description}
            image={image}
            noindex={noindex}
        />
        <slot name="head" />
    </head>

    <body>
        <BaseNav />

        <main>
            <slot />
            <!-- your content is injected here -->
        </main>
        <Footer />
    </body>
</html>
