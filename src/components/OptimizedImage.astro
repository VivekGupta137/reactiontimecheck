---
/**
 * OptimizedImage component for automatic image optimization
 * Provides lazy loading, responsive images, and proper SEO attributes
 */

interface Props {
    src: string;
    alt: string;
    width?: number;
    height?: number;
    loading?: "lazy" | "eager";
    class?: string;
    sizes?: string;
}

const {
    src,
    alt,
    width,
    height,
    loading = "lazy",
    class: className = "",
    sizes,
} = Astro.props;
---

<img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class={className}
    sizes={sizes}
/>
